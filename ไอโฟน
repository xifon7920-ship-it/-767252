-- 🌈 ระบบลูปสีสายรุ้ง (Rainbow Effect)
--------------------------------------------------------
local rainbowElements = {}

RunService.RenderStepped:Connect(function()
    local hue = (tick() % 3) / 3 -- วนลูปเปลี่ยนสีรุ้ง
    local rainbowColor = Color3.fromHSV(hue, 0.8, 1)
    
    -- เปลี่ยนสีขอบและหัวข้อ
    RainbowStroke.Color = rainbowColor
    Title.TextColor3 = rainbowColor
    
    -- เปลี่ยนสีองค์ประกอบสายรุ้งอื่นๆ (ปุ่มเปิดใช้งาน)
    for _, elem in pairs(rainbowElements) do
        if elem.IsSwitch then
            if elem.State then
                elem.Object.BackgroundColor3 = rainbowColor
            end
        elseif elem.IsTab then
            if elem.Selected then
                elem.Object.BackgroundColor3 = rainbowColor
            end
        end
    end
end)

